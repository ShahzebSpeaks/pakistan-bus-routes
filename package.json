{
  "name": "pakistan-bus-routes",
  "version": "0.1.0",
  "private": true,
  "description": "Open-source routes, stops, fares and trip planner for public buses, BRT and metro in Pakistan.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "predev": "node scripts/build-data.mjs",
    "dev": "vite",
    "prebuild": "node scripts/build-data.mjs",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "data:import": "node scripts/import-research.mjs",
    "data:osm": "node scripts/fetch-osm.mjs",
    "data:geocode": "node scripts/geocode.mjs",
    "data:shapes": "node scripts/shapes.mjs",
    "data:build": "node scripts/build-data.mjs",
    "data:validate": "node scripts/validate.mjs",
    "data:all": "npm run data:osm && npm run data:geocode && npm run data:shapes && npm run data:validate && npm run data:build",
    "icons": "python scripts/assets/make-icons.py",
    "preview:maps": "node scripts/preview-svg.mjs",
    "data:names": "node scripts/enrich-names.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "leaflet": "1.9",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.22",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.1.1",
    "fflate": "^0.8.3",
    "typescript": "^5.9.3",
    "vite": "^8.3.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.1"
  }
}
